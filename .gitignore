# =============================================================================
# .gitignore — Loop
# 覆盖：操作系统 / 编辑器与 IDE / 环境变量与日志 / 常见语言与运行时
# 如确定技术栈，可按需删除无关部分。
# =============================================================================

# -----------------------------------------------------------------------------
# 操作系统生成文件
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
*.swo

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# 编辑器与 IDE
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.code-workspace

# JetBrains (IntelliJ IDEA / PyCharm / WebStorm / GoLand / CLion 等)
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
out/
cmake-build-*/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Neovim
[._]*.s[a-v][a-z]
*.swp
*.swo
*.un~
Session.vim
tags

# Emacs
\#*\#
.\#*
*~
\*.elc
auto-save-list

# Eclipse / Spring Tool Suite
.settings/
.project
.classpath
.factorypath
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/

