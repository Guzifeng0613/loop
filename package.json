{
  "name": "loop-agent-workbench",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm.cmd run build -w @loop/contracts && node scripts/dev.mjs",
    "build": "npm.cmd run build -w @loop/contracts && npm.cmd run build -w @loop/web && npm.cmd run build -w @loop/server",
    "pretypecheck": "npm.cmd run build -w @loop/contracts",
    "typecheck": "npm.cmd run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --maxWorkers 1",
    "test:watch": "vitest",
    "start": "npm.cmd run start -w @loop/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
